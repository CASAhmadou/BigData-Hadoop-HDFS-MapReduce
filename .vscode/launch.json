{
    // Utilisez IntelliSense pour en savoir plus sur les attributs possibles.
    // Pointez pour afficher la description des attributs existants.
    // Pour plus d'informations, visitez : https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "WordCount",
            "request": "launch",
            "mainClass": "hadoop.mapreduce.tp1.WordCount",
             "args": [
                "src/main/resources/input/file.txt",
                "src/main/resources/output"
            ]
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Lancer Chrome en utilisant localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "SalesByStore",
            "request": "launch",
            "mainClass": "hadoop.mapreduce.tp1.SalesByStore",
            "args": [
                "src/main/resources/input/purchases_sample.txt", 
                "src/main/resources/output_sales"
            ]
        }        
    ]
}